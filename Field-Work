.brand{display:inline-flex;align-items:center;gap:7px;font-weight:500;font-size:15px;letter-spacing:-.02em}
.brand svg{width:18px;height:18px}
.brand .sup{font-size:.6em;top:-.1em}
.nav__links{display:flex;align-items:center;gap:0;font-size:13px}
.nav__links a{position:relative;overflow:hidden;display:inline-block}
.nav__links a span{display:block;position:relative;padding:6px 2px;line-height:1.5;transition:transform .5s var(--ease)}
.nav__links a span::after{content:attr(data-t);position:absolute;left:0;top:100%;padding:6px 2px;line-height:1.5}
.nav__links a:hover span{transform:translateY(-100%)}
.nav__links .plus{color:var(--ghost);margin:0 clamp(18px,3.4vw,52px);font-size:13px}
.burger{width:44px;height:44px;display:grid;place-content:center;gap:6px;margin-right:-8px}
.burger i{display:block;width:28px;height:1.5px;background:var(--ink);transition:transform .5s var(--ease),width .5s var(--ease)}
.burger:hover i:last-child{width:18px;transform:translateX(10px)}

/* ---------- Menu overlay ---------- */
.menu{position:fixed;inset:0;z-index:60;background:var(--dark);color:#f4f4f4;clip-path:inset(0 0 100% 0);transition:clip-path .9s var(--ease);display:flex;flex-direction:column;padding:20px calc(var(--edge) + 16px) 36px;pointer-events:none}
.menu.is-open{clip-path:inset(0 0 0 0);pointer-events:auto}
.menu__top{display:flex;justify-content:space-between;align-items:center;height:44px}
.menu__close{width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.3);display:grid;place-items:center;transition:transform .5s var(--ease)}
.menu__close:hover{transform:rotate(90deg)}
.menu__list{margin-top:auto;display:flex;flex-direction:column;gap:4px}
.menu__list a{display:flex;align-items:baseline;gap:18px;font-size:clamp(44px,8vw,104px);line-height:1;letter-spacing:-.045em;overflow:hidden}
.menu__list a span{display:inline-block;transform:translateY(105%);transition:transform .9s var(--ease)}
.menu__list a small{font-size:12px;letter-spacing:0;color:rgba(255,255,255,.4);transform:translateY(105%);transition:transform .9s var(--ease)}
.menu.is-open .menu__list a span,.menu.is-open .menu__list a small{transform:none}
.menu__list a:hover span{color:#9a9a9a}
.menu__foot{display:flex;justify-content:space-between;margin-top:40px;font-size:13px;color:rgba(255,255,255,.55)}

/* ---------- Hero ---------- */
.hero{position:relative;margin:76px var(--edge) 0;aspect-ratio:2000/1333;min-height:560px;border-radius:var(--r);background:var(--hero);overflow:hidden;isolation:isolate}
.hero__media{position:absolute;inset:0;z-index:-1}
.hero__media img{width:100%;height:100%;object-fit:cover;object-position:50% 50%;transform-origin:50% 50%;will-change:transform}
.hero__media::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(10,14,8,.38) 0%,rgba(10,14,8,0) 30%)}
.hero__top{display:flex;justify-content:space-between;align-items:flex-start;gap:32px;padding:clamp(22px,2.6vw,38px) var(--pad) 0}
.wordmark{font-weight:500;font-size:clamp(72px, 11.8vw, 200px);line-height:.84;letter-spacing:-.06em;white-space:nowrap;will-change:transform}
.wordmark .mask{display:inline-block;overflow:hidden;padding:.06em .02em .04em 0;vertical-align:top}
.wordmark .ch{display:inline-block;will-change:transform}
.wordmark .sup{font-size:.3em;top:.16em;margin-left:.04em;font-weight:400}
.hero__aside{width:300px;flex:none;padding-top:clamp(10px,1.4vw,22px)}
.crew{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.crew .av{width:26px;height:26px;border-radius:50%;overflow:hidden;background:#cfcfcd;flex:none;box-shadow:0 0 0 2px var(--hero)}
.crew .av img{width:100%;height:100%;object-fit:cover}
.crew .ln{width:44px;height:1px;background:var(--ink);transform-origin:left}
.crew .pair{display:flex}
.crew .pair .av + .av{margin-left:-8px}
.crew .tag{font-size:10px;letter-spacing:.06em;text-transform:uppercase;margin-left:6px}
.hero__aside p{font-size:13px;line-height:1.55;color:var(--ink);max-width:264px}
.hero__bottom{position:absolute;left:var(--pad);right:var(--pad);bottom:clamp(20px,2.4vw,32px);display:flex;align-items:flex-end;justify-content:space-between;gap:24px;color:#fff}
.trust{flex:1;min-width:0;max-width:640px}
.trust p{font-size:12px;line-height:1.5;max-width:230px;opacity:.9;margin-bottom:16px}
.logos{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 88%,transparent)}
.logos__track{display:flex;width:max-content;animation:marquee 32s linear infinite}
.logos:hover .logos__track{animation-play-state:paused}
.logo{display:inline-flex;align-items:center;gap:8px;font-size:15px;font-weight:500;letter-spacing:-.02em;margin-right:44px;white-space:nowrap;opacity:.88}
.logo svg{width:18px;height:18px}
@keyframes marquee{to{transform:translateX(-50%)}}

.feature{position:relative;width:236px;flex:none;background:#fff;color:var(--ink);border-radius:var(--r-md);padding:6px 6px 0;box-shadow:0 24px 50px -24px rgba(0,0,0,.45);transition:transform .6s var(--ease)}
.feature:hover{transform:translateY(-6px)}
.feature__img{position:relative;height:150px;border-radius:11px;overflow:hidden;background:#d8d8d6}
.feature__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.08);transition:opacity .8s ease,transform 1.4s var(--ease)}
.feature__img img.is-on{opacity:1;transform:scale(1)}
.feature__cap{display:flex;justify-content:space-between;align-items:center;padding:10px 8px 12px}
.feature__txt{position:relative;height:36px;flex:1;overflow:hidden}
.feature__txt div{position:absolute;inset:0;transition:transform .7s var(--ease),opacity .5s ease;transform:translateY(100%);opacity:0}
.feature__txt div.is-on{transform:none;opacity:1}
.feature__txt div.is-out{transform:translateY(-100%);opacity:0}
.feature__txt b{display:block;font-weight:500;font-size:13px;letter-spacing:-.01em}
.feature__txt span{font-size:11px;color:var(--ink-2)}
.feature__txt span em{font-style:normal;margin-left:10px}
.feature__go{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;transition:background .3s,color .3s,transform .5s var(--ease)}
.feature:hover .feature__go{background:var(--ink);color:#fff;transform:rotate(45deg)}
.feature__bar{position:absolute;left:14px;right:14px;bottom:0;height:2px;background:var(--line);border-radius:2px;overflow:hidden}
.feature__bar i{display:block;height:100%;width:100%;background:var(--ink);transform:scaleX(0);transform-origin:left}

/* ---------- About ---------- */
.about{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;padding:clamp(100px,11vw,160px) calc(var(--edge) + var(--pad)) clamp(90px,9vw,130px)}
.about .label{grid-column:1 / span 3;align-self:start;padding-top:10px}
.statement{grid-column:5 / span 8;font-size:clamp(26px, 2.55vw, 38px);line-height:1.2;letter-spacing:-.028em;font-weight:400}
.statement .word{color:var(--ghost)}
.statement .slash{color:var(--muted);margin:0 .2em}

/* ---------- Stats ---------- */
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--edge);margin:0 var(--edge)}
.stat{position:relative;height:clamp(220px,18vw,260px);border-radius:var(--r-md);background:var(--soft);padding:20px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}
.stat__num{font-size:clamp(44px,3.8vw,58px);line-height:1;letter-spacing:-.05em;font-weight:400}
.stat__num sup{font-size:.4em;vertical-align:top;position:relative;top:.05em;margin-left:2px}
.stat__k{font-size:12px;color:var(--ink-2);margin-bottom:6px}
.stat--team{padding:0 0 20px}
.faces{display:flex;flex-direction:column;gap:8px;padding-top:16px;-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 14%,#000 86%,transparent);mask-image:linear-gradient(90deg,transparent 0,#000 14%,#000 86%,transparent)}
.faces__row{display:flex;gap:8px;width:max-content;animation:facesR 26s linear infinite}
.faces__row:nth-child(2){animation-name:facesL}
.faces span{width:64px;height:64px;border-radius:50%;overflow:hidden;background:#dcdcda;flex:none}
.faces img{width:100%;height:100%;object-fit:cover}
@keyframes facesR{from{transform:translateX(-50%)}to{transform:translateX(0)}}
@keyframes facesL{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.stat__line{display:flex;align-items:baseline;gap:12px;padding:0 20px}
.stat__line .stat__k{margin:0}
.stat--dark{background:var(--dark);color:#f4f4f4}
.stat--dark .stat__k{color:rgba(255,255,255,.7)}
.stat--dark p{font-size:12px;line-height:1.5;color:rgba(255,255,255,.62);max-width:220px}
.seal{position:absolute;top:14px;right:14px;width:92px;height:92px}
.seal .ring{animation:spin 22s linear infinite;transform-origin:50% 50%}
@keyframes spin{to{transform:rotate(360deg)}}
.stat--story p{font-size:12px;line-height:1.5;color:var(--ink-2);max-width:240px}
.stat--story .row{display:flex;align-items:flex-end;gap:14px}
.stat--story .thumb{width:68px;height:74px;border-radius:10px;overflow:hidden;flex:none;background:#2b3a22}
.stat--story .thumb img{width:100%;height:100%;object-fit:cover}
.stat--photo{color:#fff;background:#4d6b34}
.stat--photo > img{position:absolute;inset:-10%;width:120%;height:120%;object-fit:cover;filter:blur(3px) saturate(1.05);transform:scale(1.05)}
.stat--photo::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.18),rgba(0,0,0,.05) 50%,rgba(0,0,0,.35));z-index:1}
.stat--photo > *:not(img){position:relative;z-index:2}
.stat--photo .stat__k{color:rgba(255,255,255,.88)}
.stat--photo p{font-size:12px;line-height:1.5;max-width:220px;color:rgba(255,255,255,.85)}

/* ---------- Services ---------- */
.services{margin:clamp(90px,9vw,130px) var(--edge) 0;background:var(--dark);color:#f2f2f2;border-radius:var(--r);padding:clamp(40px,4.4vw,64px) var(--pad) clamp(44px,4.4vw,64px)}
.services__head{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end;margin-bottom:clamp(36px,4vw,56px)}
.services__head .h2{margin-top:18px}
.services__aside{text-align:right}
.services__aside p{font-size:12px;line-height:1.55;color:rgba(255,255,255,.62);max-width:270px;margin:0 0 14px auto}
.pills{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;height:28px;padding:0 13px;border:1px solid rgba(255,255,255,.4);border-radius:999px;font-size:10.5px;letter-spacing:.04em;text-transform:uppercase;transition:background .3s,color .3s}
.pill:hover{background:#f2f2f2;color:var(--dark)}
.svc{display:grid;grid-template-columns:clamp(70px,15%,200px) minmax(0,1fr) 44px;gap:0;padding:30px 0;border-bottom:1px solid var(--line-d);cursor:pointer}
.svc:first-child{border-top:1px solid var(--line-d)}
.svc__idx{font-size:11px;color:rgba(255,255,255,.5);padding-top:8px}
.svc__main{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,4vw,60px);align-items:start}
.svc__title{font-size:clamp(22px,1.9vw,28px);font-weight:400;letter-spacing:-.03em;line-height:1.15;transition:transform .6s var(--ease)}
.svc:hover .svc__title{transform:translateX(8px)}
.svc__more{display:grid;grid-template-rows:0fr;transition:grid-template-rows .8s var(--ease)}
.svc__more > div{overflow:hidden}
.svc__more p{font-size:12.5px;line-height:1.6;color:rgba(255,255,255,.62);max-width:380px;padding-top:14px}
.chips{display:flex;flex-wrap:wrap;gap:6px;padding-top:18px}
.chip{height:28px;display:inline-flex;align-items:center;padding:0 12px;border:1px solid rgba(255,255,255,.38);border-radius:999px;font-size:11px}
.svc__side{display:grid}
.svc__side > *{grid-area:1/1}
.svc__desc{font-size:12.5px;line-height:1.6;color:rgba(255,255,255,.62);max-width:420px;transition:opacity .45s ease,transform .6s var(--ease)}
.svc__pics{display:flex;gap:14px;opacity:0;pointer-events:none;max-height:0;transition:max-height .8s var(--ease),opacity .5s ease}
.svc__pics span{width:clamp(120px,11vw,168px);aspect-ratio:1;overflow:hidden;background:#333;flex:none}
.svc__pics span{border-radius:14px}
.svc__pics img{width:100%;height:100%;object-fit:cover}
.svc__tog{width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.55);position:relative;justify-self:end;transition:background .3s,border-color .3s}
.svc__tog::before,.svc__tog::after{content:"";position:absolute;left:50%;top:50%;width:13px;height:1.5px;background:#f2f2f2;translate:-50% -50%;transition:transform .6s var(--ease),background .3s}
.svc__tog::after{transform:rotate(90deg)}
.svc:hover .svc__tog{background:#f2f2f2;border-color:#f2f2f2}
.svc:hover .svc__tog::before,.svc:hover .svc__tog::after{background:var(--dark)}
.svc.is-open .svc__more{grid-template-rows:1fr}
.svc.is-open .svc__desc{opacity:0;transform:translateY(-8px)}
.svc.is-open .svc__pics{opacity:1;pointer-events:auto;max-height:200px}
.svc.is-open .svc__tog::after{transform:rotate(0)}
.services__cta{margin-top:36px;padding-left:clamp(70px,15%,200px)}
.btn{display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:999px;background:#fff;color:var(--ink);font-size:13px;font-weight:500;will-change:transform}
.btn svg{width:12px;height:12px;transition:transform .5s var(--ease)}
.btn:hover svg{transform:rotate(45deg)}
.btn--share{transition:background .4s var(--ease),color .4s var(--ease)}
.btn--share:hover{background:#cfe8a9;color:var(--ink)}
.btn--dark{background:var(--ink);color:#fff}

/* ---------- Projects ---------- */
.work{margin:var(--edge) var(--edge) 0;position:relative}
.proj{position:sticky;top:var(--edge);height:min(860px, calc(100svh - 24px));min-height:560px;margin-bottom:var(--edge)}
.proj:last-child{margin-bottom:0}
.proj__inner{position:relative;height:100%;border-radius:var(--r);overflow:hidden;color:#fff;background:#3a4a2c;transform-origin:50% 0;will-change:transform}
.proj__img{position:absolute;inset:0;overflow:hidden}
.proj__img img{width:100%;height:115%;object-fit:cover;will-change:transform}
.proj__inner::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.28) 0%,rgba(0,0,0,0) 26%,rgba(0,0,0,0) 56%,rgba(0,0,0,.5) 100%);pointer-events:none}
.proj__shade{position:absolute;inset:0;background:#000;opacity:0;z-index:3;pointer-events:none}
.proj__top,.proj__bottom,.proj__mark{position:absolute;z-index:2}
.proj__top{top:clamp(20px,2.4vw,32px);left:var(--pad);right:var(--pad);display:grid;grid-template-columns:clamp(130px,17%,240px) 1fr auto;gap:24px;align-items:start}
.proj__top p{font-size:12px;line-height:1.55;max-width:300px;opacity:.88}
.proj__top .count{font-size:11px;letter-spacing:.04em}
.proj__mark{left:50%;top:50%;translate:-50% -50%;display:flex;align-items:center;gap:10px;font-size:clamp(24px,2.2vw,32px);font-weight:500;letter-spacing:-.04em;white-space:nowrap}
.proj__mark svg{width:1em;height:1em}
.proj__bottom{left:var(--pad);right:var(--pad);bottom:clamp(20px,2.4vw,32px);display:flex;justify-content:space-between;align-items:flex-end;gap:24px}
.proj__title{font-size:clamp(24px,2.2vw,32px);font-weight:400;letter-spacing:-.03em;line-height:1.1;margin-bottom:14px}
.proj .chip{border-color:rgba(255,255,255,.6);background:rgba(0,0,0,.08);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.proj__meta{width:clamp(200px,20vw,260px);font-size:12px}
.proj__meta div{display:flex;justify-content:space-between;padding:9px 0}
.proj__meta div + div{border-top:1px solid rgba(255,255,255,.3)}
.proj__meta dt{opacity:.75}

/* cursor bubble on project cards */
.cursor{position:fixed;left:0;top:0;z-index:70;width:92px;height:92px;margin:-46px 0 0 -46px;border-radius:50%;background:#fff;color:var(--ink);display:grid;place-items:center;font-size:12px;font-weight:500;pointer-events:none;scale:0;transition:scale .5s var(--ease)}
.cursor.is-on{scale:1}
@media (hover:none),(pointer:coarse){.cursor{display:none}}

/* ---------- Process ---------- */
.process{padding:clamp(100px,11vw,160px) calc(var(--edge) + var(--pad)) 0}
.sec-head{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;align-items:start;margin-bottom:clamp(48px,6vw,90px)}
.sec-head .label{grid-column:1 / span 3;padding-top:12px}
.sec-head .h2{grid-column:4 / span 5}
.sec-head p{grid-column:9 / span 4;font-size:12.5px;line-height:1.6;color:var(--ink-2);max-width:330px;padding-top:6px}
.lanes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.lane{position:relative;height:clamp(240px,22vw,320px);border-top:1px solid var(--line);background-image:radial-gradient(circle,#dadad8 1px,transparent 1.3px);background-size:9px 9px;background-position:4px 4px}
.lane__bar{position:absolute;left:0;right:0;top:calc((100% - 34px - 44px) * var(--i) / 3);height:34px;background:var(--ink);color:#fff;font-size:12px;display:flex;align-items:center;padding:0 12px;transform-origin:left center;will-change:transform}
.lane__no{position:absolute;left:0;right:0;bottom:0;height:40px;display:grid;place-items:center;font-size:11px;color:var(--muted);background:var(--bg);border-top:1px solid var(--line)}
.lane__fill{position:absolute;left:0;top:0;width:1px;height:100%;background:var(--line)}
.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:20px}
.step{background:var(--soft);border-radius:var(--r-sm);padding:20px 18px 26px;transition:background .5s ease,box-shadow .5s ease}
.step h3{font-size:clamp(17px,1.4vw,20px);font-weight:400;letter-spacing:-.025em;margin-bottom:10px}
.step p{font-size:12px;line-height:1.55;color:var(--ink-2);max-width:240px}
.step.is-live{background:#fff;box-shadow:0 0 0 1px var(--line),0 18px 40px -26px rgba(0,0,0,.3)}

/* ---------- Testimonials ---------- */
.voices{padding:clamp(100px,11vw,160px) var(--edge) 0}
.voices .sec-head{padding:0 var(--pad)}
.voices .sec-head .h2{grid-column:1 / span 7;margin-top:30px}
.voices .sec-head .label{grid-column:1 / span 12;padding-top:0}
.voices .sec-head p{grid-column:9 / span 4;margin-top:-34px}
.vgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--edge);align-items:stretch}
.vcol{display:flex;flex-direction:column;gap:var(--edge)}
.rating{position:relative;flex:1;background:var(--dark);color:#f2f2f2;border-radius:var(--r-md);padding:20px;display:flex;flex-direction:column;min-height:420px}
.rating .stat__k{color:rgba(255,255,255,.75)}
.rating__num{font-size:clamp(48px,4.2vw,62px);letter-spacing:-.05em;line-height:1;margin-top:8px}
.rating__num small{font-size:.32em;letter-spacing:0;color:rgba(255,255,255,.6)}
.rating p{font-size:12px;line-height:1.55;color:rgba(255,255,255,.62);margin-top:auto;max-width:240px}
.rating__row{display:flex;align-items:center;gap:10px;margin:18px 0 16px}
.stack{display:flex}
.stack span{width:26px;height:26px;border-radius:50%;overflow:hidden;box-shadow:0 0 0 2px var(--dark);background:#444}
.stack span + span{margin-left:-8px}
.stack img{width:100%;height:100%;object-fit:cover}
.stack b{width:26px;height:26px;border-radius:50%;margin-left:-8px;background:#fff;color:var(--ink);font-size:9px;font-weight:600;display:grid;place-items:center;box-shadow:0 0 0 2px var(--dark)}
.rating__row .line{width:22px;height:1px;background:rgba(255,255,255,.4)}
.stars{display:flex;gap:2px;color:var(--star)}
.stars svg{width:11px;height:11px}
.rating__row small{display:block;font-size:10.5px;color:rgba(255,255,255,.6);margin-top:3px}
.rating .btn{width:100%;justify-content:center;height:44px}
.quote{background:var(--soft);border-radius:var(--r-md);padding:20px;display:flex;flex-direction:column;gap:22px;flex:1}
.quote__mark{width:22px;height:18px;color:var(--ink)}
.quote blockquote{font-size:clamp(17px,1.5vw,21px);line-height:1.26;letter-spacing:-.025em;text-align:center;padding:0 4px}
.quote__foot{margin-top:auto;display:flex;justify-content:space-between;align-items:flex-end;gap:12px}
.quote__foot small{display:block;font-size:10.5px;color:var(--ink-2);margin-top:4px}
.quote__foot .stars span{font-size:10.5px;color:var(--ink-2);margin-left:6px}
.quote__thumb{width:52px;height:52px;border-radius:10px;overflow:hidden;flex:none;background:#2a2a2a}
.quote__thumb img{width:100%;height:100%;object-fit:cover}
.person{background:var(--soft);border-radius:var(--r-md);padding:14px 16px;display:flex;align-items:center;gap:12px}
.person span{width:38px;height:38px;border-radius:50%;overflow:hidden;flex:none;background:#d6d6d4}
.person img{width:100%;height:100%;object-fit:cover}
.person b{display:block;font-weight:500;font-size:13.5px;letter-spacing:-.01em}
.person small{font-size:11.5px;color:var(--muted)}
.band{margin-top:var(--edge);padding:24px 0;overflow:hidden;color:#3a3a3a;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.band .logos__track{animation-duration:40s}
.band .logo{font-size:19px;margin-right:64px;opacity:.85}
.band .logo svg{width:22px;height:22px}
.band:hover .logos__track{animation-play-state:paused}

/* ---------- Footer ---------- */
.footer{margin:clamp(100px,11vw,160px) var(--edge) var(--edge);background:var(--dark);color:#f2f2f2;border-radius:var(--r);overflow:hidden}
.footer__inner{padding:clamp(36px,3.6vw,52px) var(--pad) 0}
.footer__top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px}
.footer .wordmark{font-size:clamp(76px, 12.8vw, 210px)}
.footer__year{text-align:right;font-size:clamp(22px,2.2vw,32px);letter-spacing:-.04em;padding-top:10px}
.footer__year i{display:block;width:clamp(48px,5vw,72px);height:3px;background:#f2f2f2;margin:clamp(24px,3vw,44px) 0 0 auto;transform-origin:right}
.footer__mid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;margin-top:clamp(44px,5vw,72px)}
.footer__lead{grid-column:1 / span 5}
.footer__lead p{font-size:12px;line-height:1.55;color:rgba(255,255,255,.62);max-width:250px;margin-bottom:16px}
.mail{display:inline-block;font-size:clamp(24px,2.2vw,32px);letter-spacing:-.035em;line-height:1.2;position:relative;padding-bottom:4px}
.mail::after{content:"";position:absolute;left:0;right:0;bottom:0;height:1.5px;background:currentColor;transform-origin:right;transition:transform .7s var(--ease)}
.mail:hover::after{transform:scaleX(0)}
.fcol{grid-column:span 2}
.fcol:first-of-type{grid-column:7 / span 2}
.fcol h4{font-size:10.5px;font-weight:400;letter-spacing:.04em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:14px}
.fcol li a{display:inline-block;font-size:15px;line-height:1.75;transition:color .3s,transform .5s var(--ease)}
.fcol li a:hover{color:#9d9d9d;transform:translateX(4px)}
.socials{display:flex;gap:8px}
.socials a{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.55);display:grid;place-items:center;transition:background .3s,color .3s,transform .5s var(--ease)}
.socials a:hover{background:#f2f2f2;color:var(--dark);transform:translateY(-3px)}
.socials svg{width:13px;height:13px}
.footer__info{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px;align-items:end;margin-top:clamp(56px,7vw,110px);padding-bottom:24px;font-size:10.5px;letter-spacing:.02em;text-transform:uppercase;line-height:1.5}
.footer__info div:nth-child(1){grid-column:1 / span 3}
.footer__info div:nth-child(2){grid-column:4 / span 4}
.footer__info div:nth-child(3){grid-column:8 / span 3}
.footer__info span{color:rgba(255,255,255,.55);display:block}
.totop{grid-column:11 / span 2;justify-self:end;width:42px;height:42px;border-radius:50%;border:1px solid rgba(255,255,255,.55);display:grid;place-items:center;transition:background .3s,color .3s}
.totop:hover{background:#f2f2f2;color:var(--dark)}
.totop svg{width:14px;height:14px;transition:transform .5s var(--ease)}
.totop:hover svg{transform:translateY(-3px)}
.footer__legal{display:flex;justify-content:space-between;gap:16px;border-top:1px solid var(--line-d);padding:16px var(--pad);font-size:11px;color:rgba(255,255,255,.75)}
.footer__legal nav{display:flex;gap:clamp(20px,4vw,56px)}
.footer__legal a:hover{color:#fff;text-decoration:underline}

/* ---------- Tablet ---------- */
@media (max-width:1100px){
  .nav__links{display:none}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .vgrid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .sec-head .label{grid-column:1 / -1;padding-top:0}
  .sec-head .h2{grid-column:1 / span 7}
  .sec-head p{grid-column:8 / span 5}
  .voices .sec-head p{margin-top:30px}
  .statement{grid-column:1 / -1}
  .about .label{grid-column:1 / -1}
  .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
  .footer__lead{grid-column:1 / -1}
  .fcol:first-of-type,.fcol{grid-column:span 4}
}
@media (max-width:900px){
  .hero{aspect-ratio:auto;min-height:760px;background:#7fb3e3}
  .hero__top{flex-direction:column;gap:22px}
  .wordmark{font-size:clamp(64px,17vw,150px)}
  .hero__media{inset:auto 0 0 0}
  .hero__media img{height:auto}
  .services__head{grid-template-columns:1fr}
  .services__aside{text-align:left}
  .services__aside p{margin:0 0 14px}
  .pills{justify-content:flex-start}
  .svc{grid-template-columns:1fr 40px;row-gap:10px}
  .svc__idx{grid-column:1 / -1;padding-top:0}
  .svc__main{grid-template-columns:1fr;gap:4px}
  .svc__tog{grid-row:2;grid-column:2}
  .svc__main{grid-row:2;grid-column:1}
  .svc__desc{padding-top:10px}
  .svc.is-open .svc__desc{display:none}
  .svc__pics{display:none;padding-top:18px}
  .svc.is-open .svc__pics{display:flex}
  .services__cta{padding-left:0}
  .proj__top{grid-template-columns:1fr auto}
  .proj__top p{display:none}
  .proj__bottom{flex-direction:column;align-items:flex-start}
}
/* ---------- Phone ---------- */
@media (max-width:640px){
  :root{--edge:8px;--pad:18px}
  .nav{padding:0 22px}
  .hero{margin-top:70px;min-height:720px}
  .hero__aside{width:100%}
  .feature{display:none}
  .about{padding-left:26px;padding-right:26px;gap:18px}
  .statement{font-size:25px}
  .stats{grid-template-columns:1fr}
  .stat{height:210px}
  .sec-head{gap:16px}
  .sec-head .h2,.sec-head p,.voices .sec-head p{grid-column:1 / -1;margin-top:0}
  .voices .sec-head .h2{margin-top:16px}
  .process{padding-left:22px;padding-right:22px}
  .lanes{gap:4px}
  .lane{height:220px}
  .lane__bar{font-size:10px;padding:0 6px;height:28px;top:calc((100% - 28px - 44px) * var(--i) / 3)}
  .steps{grid-template-columns:1fr}
  .vgrid{grid-template-columns:1fr}
  .rating{min-height:380px}
  .proj{min-height:520px;height:calc(100svh - 120px)}
  .proj__meta{width:100%}
  .proj__mark{top:44%}
  .footer__top{flex-direction:column}
  .footer__year{text-align:left}
  .footer__year i{margin-left:0;transform-origin:left}
  .fcol:first-of-type,.fcol{grid-column:span 6}
  .fcol:last-of-type{grid-column:1 / -1}
  .footer__info div:nth-child(n){grid-column:1 / -1}
  .totop{grid-column:1 / -1;justify-self:start}
  .footer__legal{flex-direction:column}
}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
  .logos__track{animation:none}
}
