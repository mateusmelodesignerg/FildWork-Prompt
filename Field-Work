<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script>
(() => {
  const $ = (s, c = document) => c.querySelector(s);
  const $$ = (s, c = document) => [...c.querySelectorAll(s)];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

  // Always start at the top so the intro plays from the first frame
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  if (!location.hash) window.scrollTo(0, 0);

  // Hide broken images without layout shift
  $$('img').forEach(img => img.addEventListener('error', () => img.classList.add('broken')));

  // ---------- Smooth scroll ----------
  let lenis = null;
  const hasGsap = typeof gsap !== 'undefined';
  if (hasGsap) gsap.registerPlugin(ScrollTrigger);
  if (!reduce && typeof Lenis !== 'undefined') {
    lenis = new Lenis({ lerp: 0.09, wheelMultiplier: 1, smoothWheel: true });
    if (hasGsap) {
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(t => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
    } else {
      const raf = t => { lenis.raf(t); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
    }
  }
  const scrollTo = (target) => {
    if (lenis) lenis.scrollTo(target, { duration: 1.6, easing: t => 1 - Math.pow(1 - t, 4) });
    else (typeof target === 'number' ? window.scrollTo({ top: target, behavior: 'smooth' }) : target.scrollIntoView({ behavior: 'smooth' }));
  };

  // ---------- Nav: anchors, hide on scroll down, menu ----------
  const nav = $('#nav'), menu = $('#menu'), burger = $('#burger');
  const setMenu = open => {
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    burger.setAttribute('aria-expanded', String(open));
    if (lenis) open ? lenis.stop() : lenis.start();
  };
  burger.addEventListener('click', () => setMenu(true));
  $('#menuClose').addEventListener('click', () => setMenu(false));
  addEventListener('keydown', e => { if (e.key === 'Escape') setMenu(false); });
  $$('a[href^="#"]').forEach(a => a.addEventListener('click', e => {
    const id = a.getAttribute('href');
    if (id.length < 2) { e.preventDefault(); return; }
    const el = $(id); if (!el) return;
    e.preventDefault();
    const wasOpen = menu.classList.contains('is-open');
    setMenu(false);
    setTimeout(() => scrollTo(id === '#top' ? 0 : el), wasOpen ? 350 : 0);
  }));
  $('#toTop').addEventListener('click', () => scrollTo(0));

  let lastY = 0;
  const onScroll = y => {
    nav.classList.toggle('is-scrolled', y > 40);
    nav.classList.toggle('is-hidden', y > 220 && y > lastY && !menu.classList.contains('is-open'));
    lastY = y;
  };
  if (lenis) lenis.on('scroll', ({ scroll }) => onScroll(scroll));
  else addEventListener('scroll', () => onScroll(scrollY), { passive: true });

  // ---------- Featured card carousel ----------
  const fImgs = $$('#feature .feature__img img'), fTxt = $$('#feature .feature__txt div'), fBar = $('#featureBar');
  let fIdx = 0;
  const FEATURE_MS = 4200;
  const nextFeature = () => {
    const prev = fIdx; fIdx = (fIdx + 1) % fImgs.length;
    fImgs[prev].classList.remove('is-on'); fImgs[fIdx].classList.add('is-on');
    fTxt[prev].classList.remove('is-on'); fTxt[prev].classList.add('is-out');
    fTxt[fIdx].classList.remove('is-out'); fTxt[fIdx].classList.add('is-on');
    setTimeout(() => fTxt[prev].classList.remove('is-out'), 700);
  };
  if (hasGsap && !reduce) {
    const loop = () => gsap.fromTo(fBar, { scaleX: 0 }, { scaleX: 1, duration: FEATURE_MS / 1000, ease: 'none', onComplete: () => { nextFeature(); loop(); } });
    gsap.delayedCall(1.6, loop);
  } else setInterval(nextFeature, FEATURE_MS);

  // ---------- Services accordion ----------
  const svcs = $$('[data-svc]');
  const openSvc = (svc) => {
    const willOpen = !svc.classList.contains('is-open');
    svcs.forEach(s => { s.classList.remove('is-open'); $('.svc__tog', s).setAttribute('aria-expanded', 'false'); });
    if (!willOpen) return;
    svc.classList.add('is-open');
    $('.svc__tog', svc).setAttribute('aria-expanded', 'true');
    if (hasGsap && !reduce) {
      gsap.fromTo($$('.svc__pics span', svc), { scale: .6, rotate: -8, opacity: 0 }, { scale: 1, rotate: 0, opacity: 1, duration: 1, ease: 'expo.out', stagger: .08 });
    }
    setTimeout(() => hasGsap && ScrollTrigger.refresh(), 850);
  };
  svcs.forEach(s => s.addEventListener('click', () => openSvc(s)));

  // ---------- Magnetic buttons ----------
  if (fine && hasGsap) $$('[data-magnet]').forEach(btn => {
    const xTo = gsap.quickTo(btn, 'x', { duration: .6, ease: 'expo.out' });
    const yTo = gsap.quickTo(btn, 'y', { duration: .6, ease: 'expo.out' });
    btn.addEventListener('mousemove', e => { const r = btn.getBoundingClientRect(); xTo((e.clientX - r.left - r.width / 2) * .3); yTo((e.clientY - r.top - r.height / 2) * .4); });
    btn.addEventListener('mouseleave', () => { xTo(0); yTo(0); });
  });

  // ---------- Cursor bubble on project cards ----------
  const cursor = $('#cursor');
  if (fine && hasGsap) {
    const cx = gsap.quickTo(cursor, 'x', { duration: .5, ease: 'expo.out' });
    const cy = gsap.quickTo(cursor, 'y', { duration: .5, ease: 'expo.out' });
    addEventListener('mousemove', e => { cx(e.clientX); cy(e.clientY); });
    $$('[data-proj]').forEach(p => {
      p.addEventListener('mouseenter', () => cursor.classList.add('is-on'));
      p.addEventListener('mouseleave', () => cursor.classList.remove('is-on'));
    });
  }

  // ---------- Count-up helper ----------
  const countUp = (el) => {
    const end = parseFloat(el.dataset.count), dec = +(el.dataset.dec || 0);
    if (!hasGsap || reduce) { el.textContent = end.toFixed(dec); return; }
    const o = { v: 0 };
    gsap.to(o, { v: end, duration: 2, ease: 'power3.out', onUpdate: () => el.textContent = o.v.toFixed(dec) });
  };

  // Split headings into masked words
  $$('[data-split]').forEach(h => {
    const parts = h.innerHTML.split(/(<br\s*\/?>)/i);
    h.innerHTML = parts.map(p => /<br/i.test(p) ? p : p.trim().split(/\s+/).map(w => `<span class="w"><span>${w}</span></span>`).join(' ')).join('');
  });
  // Split the statement into words (keeps the slash as its own token)
  const st = $('#statement');
  st.innerHTML = st.innerHTML.replace(/<span class="slash">\/<\/span>/, ' §SLASH§ ').trim().split(/\s+/)
    .map(w => w === '§SLASH§' ? '<span class="slash">/</span>' : `<span class="word">${w}</span>`).join(' ');

  if (!hasGsap || reduce) {
    $$('[data-count]').forEach(countUp);
    $$('.statement .word').forEach(w => w.style.color = 'var(--ink)');
    return;
  }

  // ---------- Entrance timeline ----------
  const heroChars = $$('#heroMark .ch, #heroMark .ch-sup');
  gsap.set(heroChars, { yPercent: 110 });
  gsap.set('#hero', { clipPath: 'inset(6% 5% 6% 5% round 28px)' });
  gsap.set('.hero__media img', { scale: 1.12 });
  gsap.set('[data-hero-fade]', { y: 24, opacity: 0 });
  gsap.set('#feature', { x: 60, opacity: 0 });
  gsap.set('.crew .ln', { scaleX: 0 });
  gsap.set(nav, { yPercent: -100, opacity: 0 });

  const intro = gsap.timeline({ defaults: { ease: 'expo.out' }, delay: .15 });
  intro.to('#hero', { clipPath: 'inset(0% 0% 0% 0% round 20px)', duration: 1.5 })
       .to('.hero__media img', { scale: 1, duration: 2.2 }, 0)
       .to(heroChars, { yPercent: 0, duration: 1.3, stagger: .045 }, .35)
       .to(nav, { yPercent: 0, opacity: 1, duration: 1 }, .6)
       .to('[data-hero-fade]', { y: 0, opacity: 1, duration: 1.1, stagger: .1 }, .8)
       .to('.crew .ln', { scaleX: 1, duration: 1 }, 1)
       .to('#feature', { x: 0, opacity: 1, duration: 1.3 }, 1.05);

  // Hero scroll parallax
  gsap.timeline({ scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: true } })
    .to('#heroMark', { yPercent: -40, opacity: .2, ease: 'none' }, 0)
    .to('.hero__aside', { y: -60, ease: 'none' }, 0)
    .to('#feature', { y: -50, ease: 'none' }, 0);

  // ---------- Generic reveals ----------
  $$('[data-reveal]').forEach(el => gsap.from(el, { y: 36, opacity: 0, duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: el, start: 'top 90%' } }));
  $$('[data-split]').forEach(h => gsap.from($$('.w > span', h), { yPercent: 115, duration: 1.2, ease: 'expo.out', stagger: .05, scrollTrigger: { trigger: h, start: 'top 88%' } }));

  // Statement: words fill from grey to ink as you scroll
  gsap.to('.statement .word', { color: '#121212', stagger: .1, ease: 'none', scrollTrigger: { trigger: '#statement', start: 'top 85%', end: 'bottom 35%', scrub: .6 } });

  // Stats cards + count-up
  ScrollTrigger.batch('.stats [data-card]', { start: 'top 88%', once: true, onEnter: b => gsap.fromTo(b, { y: 70, opacity: 0 }, { y: 0, opacity: 1, duration: 1.3, ease: 'expo.out', stagger: .1 }) });
  gsap.set('.stats [data-card]', { opacity: 0 });
  $$('[data-count]').forEach(el => ScrollTrigger.create({ trigger: el, start: 'top 92%', once: true, onEnter: () => countUp(el) }));
  gsap.from('.faces__row', { opacity: 0, y: 24, duration: 1.2, ease: 'expo.out', stagger: .12, scrollTrigger: { trigger: '.faces', start: 'top 88%' } });
  gsap.to('[data-drift]', { yPercent: -8, ease: 'none', scrollTrigger: { trigger: '.stats', start: 'top bottom', end: 'bottom top', scrub: true } });

  // Services: dark panel widens in, rows slide up
  gsap.fromTo('.services', { clipPath: 'inset(4% 3% 0% 3% round 32px)' }, { clipPath: 'inset(0% 0% 0% 0% round 20px)', ease: 'none', scrollTrigger: { trigger: '.services', start: 'top 95%', end: 'top 35%', scrub: true } });
  gsap.from('.svc', { y: 50, opacity: 0, duration: 1.1, ease: 'expo.out', stagger: .1, scrollTrigger: { trigger: '#svcList', start: 'top 85%' } });
  gsap.from('.svc.is-open .svc__pics span', { scale: .6, rotate: -8, opacity: 0, duration: 1.2, ease: 'expo.out', stagger: .1, scrollTrigger: { trigger: '#svcList', start: 'top 80%' } });

  // Projects: stacked sticky cards, image parallax, previous card recedes
  const projs = $$('[data-proj]');
  projs.forEach((p, i) => {
    const img = $('.proj__img img', p);
    gsap.fromTo(img, { yPercent: -8 }, { yPercent: 0, ease: 'none', scrollTrigger: { trigger: p, start: 'top bottom', end: 'top top', scrub: true } });
    gsap.from($$('.proj__mark, .proj__title, .proj__bottom .chip, .proj__meta div', p), { y: 30, opacity: 0, duration: 1.1, ease: 'expo.out', stagger: .06, scrollTrigger: { trigger: p, start: 'top 55%' } });
    const next = projs[i + 1];
    if (next) {
      gsap.timeline({ scrollTrigger: { trigger: next, start: 'top bottom', end: 'top top', scrub: true } })
        .to($('.proj__inner', p), { scale: .9, borderRadius: 28, ease: 'none' }, 0)
        .to($('.proj__shade', p), { opacity: .55, ease: 'none' }, 0);
    }
  });

  // Process: bars slide down into a staircase and grow; matching step lights up
  const bars = $$('.lane__bar'), steps = $$('.step');
  const procTl = gsap.timeline({ scrollTrigger: { trigger: '#lanes', start: 'top 80%', end: 'bottom 40%', scrub: .8,
    onUpdate: self => { const n = Math.min(3, Math.floor(self.progress * 4.2)); steps.forEach((s, i) => s.classList.toggle('is-live', i === n)); } } });
  bars.forEach((b, i) => {
    procTl.fromTo(b, { y: () => -b.offsetTop, scaleX: .18 }, { y: 0, scaleX: 1, ease: 'power2.out', duration: 1 }, i * .55);
  });
  gsap.from('.step', { y: 40, opacity: 0, duration: 1.1, ease: 'expo.out', stagger: .08, scrollTrigger: { trigger: '#steps', start: 'top 92%' } });

  // Testimonials: columns rise with a slight tilt
  gsap.set('.vgrid [data-card]', { opacity: 0 });
  ScrollTrigger.batch('.vgrid [data-card]', { start: 'top 90%', once: true, onEnter: b => gsap.fromTo(b, { y: 80, rotate: 1.5, opacity: 0 }, { y: 0, rotate: 0, opacity: 1, duration: 1.4, ease: 'expo.out', stagger: .12 }) });
  gsap.from('.band', { y: 40, opacity: 0, duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: '.band', start: 'top 95%' } });

  // Footer: wordmark letters rise, year line draws
  const footChars = $$('#footMark .ch, #footMark .ch-sup');
  gsap.from(footChars, { yPercent: 110, duration: 1.3, ease: 'expo.out', stagger: .045, scrollTrigger: { trigger: '.footer', start: 'top 75%' } });
  gsap.from('#yearLine', { scaleX: 0, duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: '.footer', start: 'top 70%' } });

  // Refresh measurements once fonts and images settle
  document.fonts && document.fonts.ready.then(() => ScrollTrigger.refresh());
  addEventListener('load', () => {
    if (!location.hash) { lenis ? lenis.scrollTo(0, { immediate: true }) : window.scrollTo(0, 0); }
    ScrollTrigger.refresh();
  });
})();
</script>
</body>
</html>

